# Copy to .env and adjust. Never commit a real .env (it is git-ignored).

# --- Local paths -----------------------------------------------------------
DATA_DIR=./data

# --- Database --------------------------------------------------------------
# Local laptop mode (no docker): SQLite file. docker-compose mode: Postgres.
# DATABASE_URL=sqlite:///./data/local.db
DATABASE_URL=postgresql+psycopg2://credit:credit@localhost:5432/credit
POSTGRES_USER=credit
POSTGRES_PASSWORD=credit
POSTGRES_DB=credit

# --- Raw/curated storage ---------------------------------------------------
# local   -> read/write ${DATA_DIR}/raw and ${DATA_DIR}/curated on disk
# azurite -> Azure Blob emulator (docker-compose), wasb:// scheme
# azure   -> real Azure Storage / ADLS Gen2 (AZURE_STORAGE_SCHEME=abfss or wasbs)
STORAGE_BACKEND=azurite
AZURE_STORAGE_ACCOUNT=devstoreaccount1
# Public, well-known Azurite development key (not a secret). Replace for real Azure.
AZURE_STORAGE_KEY=Eby8vdM02xNOcqFlqUwJPLlmEtlCDXJ1OUzFT50uSRZ6IFsuFq2UVErCz4I6tq/K1SZFPTOtr/KBHBeksoGMGw==
AZURE_STORAGE_SCHEME=wasbs
# Host-side connection string used by the upload script / Airflow sensor (Azurite on localhost:10000)
AZURE_STORAGE_CONNECTION_STRING=DefaultEndpointsProtocol=http;AccountName=devstoreaccount1;AccountKey=Eby8vdM02xNOcqFlqUwJPLlmEtlCDXJ1OUzFT50uSRZ6IFsuFq2UVErCz4I6tq/K1SZFPTOtr/KBHBeksoGMGw==;BlobEndpoint=http://localhost:10000/devstoreaccount1;
RAW_CONTAINER=raw
CURATED_CONTAINER=curated
# Optional service-principal auth for abfss on real Azure
AZURE_CLIENT_ID=
AZURE_CLIENT_SECRET=
AZURE_TENANT_ID=

# --- Spark -----------------------------------------------------------------
SPARK_MASTER_URL=local[*]
SPARK_JARS_PACKAGES=org.apache.hadoop:hadoop-azure:3.3.4,com.microsoft.azure:azure-storage:8.6.6,org.postgresql:postgresql:42.7.3

# --- LLM triage --------------------------------------------------------------
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
TRIAGE_CONFIDENCE_THRESHOLD=0.70
TRIAGE_MAX_INPUT_TOKENS=3000
TRIAGE_MAX_OUTPUT_TOKENS=400
# tiktoken (exact) or heuristic (chars/4, no tokenizer download needed)
TRIAGE_TOKENIZER=tiktoken
# Secret salt for HMAC pseudonymisation of counterparty identifiers. Change it.
MASKING_SALT=change-me
# USD per 1M tokens - fill from the provider's current price list to get cost per break.
OPENAI_PRICE_INPUT_PER_1M=
OPENAI_PRICE_OUTPUT_PER_1M=
# Airflow: set to true to generate triage suggestions after DQ (still needs human approval)
TRIAGE_ENABLED=false
